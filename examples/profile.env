# Integrator profile.env fragment. Merge into profiles/default/profile.env.
# IANA dest is 830. Residual is the shipped default because many hosts
# already run something on 830 or cannot bind it. RESTCONF dest 443
# belongs to LabSSO; do not move RESTCONF there. Management stays high.
LABNETCONF_SSH_PORT=10830
LABNETCONF_RESTCONF_PORT=18303
LABNETCONF_REST_PORT=18830
